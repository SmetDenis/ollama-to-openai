# Ollama to OpenAI Adapter - Manual Test Cases
# Use with REST Client extensions in VS Code or similar HTTP clients
# Make sure the server is running: python3 ollama_to_openai_adapter.py

### 1. Health Check - Verify service is running
GET http://127.0.0.1:11434/health
Accept: application/json

### 2. Root Endpoint - Service information
GET http://127.0.0.1:11434/
Accept: application/json

### 3. Version - Get adapter version
GET http://127.0.0.1:11434/api/version
Accept: application/json


### 4. List Models - GET all available models
GET http://127.0.0.1:11434/api/tags
Accept: application/json

### 5. List Models - POST format (search for specific model)
POST http://127.0.0.1:11434/api/tags
Accept: application/json
Content-Type: application/json

{
    "model": "gemini/gemini-2.5-flash"
}

### 6. Show Model Details - Get model information
POST http://127.0.0.1:11434/api/show
Accept: application/json
Content-Type: application/json

{
    "model": "gemini/gemini-2.5-flash"
}

### 7. Show Model Details - With :latest suffix
POST http://127.0.0.1:11434/api/show
Accept: application/json
Content-Type: application/json

{
    "model": "gemini/gemini-2.5-flash:latest"
}

### 8. Chat Completion - Simple non-streaming chat
POST http://127.0.0.1:11434/api/chat
Accept: application/json
Content-Type: application/json

{
    "model": "openai/gpt-5-mini",
    "messages": [
        {
            "role": "user",
            "content": "Ping?"
        }
    ],
    "stream": false
}

### 9. Chat Completion - Streaming chat
POST http://127.0.0.1:11434/api/chat
Accept: application/json
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "messages": [
        {
            "role": "system",
            "content": "You are a helpful assistant."
        },
        {
            "role": "user",
            "content": "Write a short poem about coding."
        }
    ],
    "stream": true
}

### 10. Chat Completion - Multi-turn conversation
POST http://127.0.0.1:11434/api/chat
Accept: application/json
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "messages": [
        {
            "role": "user",
            "content": "What is Python?"
        },
        {
            "role": "assistant",
            "content": "Python is a high-level programming language known for its simplicity and readability."
        },
        {
            "role": "user",
            "content": "What are its main advantages?"
        }
    ],
    "stream": false
}

### 11. Generate - Simple prompt completion (non-streaming)
POST http://127.0.0.1:11434/api/generate
Accept: application/json
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "prompt": "Complete this sentence: The future of AI is",
    "stream": false
}

### 12. Generate - Streaming prompt completion
POST http://127.0.0.1:11434/api/generate
Accept: application/json
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "prompt": "Write a brief explanation of machine learning:",
    "stream": true
}

### 15. List Running Models - Mock endpoint
GET http://127.0.0.1:11434/api/ps
Accept: application/json

### 16. Error Test - Invalid model name (404 when config `models` is non-empty; forwarded upstream otherwise)
POST http://127.0.0.1:11434/api/chat
Accept: application/json
Content-Type: application/json

{
    "model": "invalid-model-name",
    "messages": [
        {
            "role": "user",
            "content": "This should fail"
        }
    ]
}

### 17. Error Test - Missing required field
POST http://127.0.0.1:11434/api/chat
Accept: application/json
Content-Type: application/json

{
    "model": "gpt-4o-mini"
}

### 18. Error Test - Empty messages array
POST http://127.0.0.1:11434/api/chat
Accept: application/json
Content-Type: application/json

{
    "model": "gpt-4o-mini",
    "messages": []
}

### 19. Error Test - Invalid JSON
POST http://127.0.0.1:11434/api/chat
Accept: application/json
Content-Type: application/json


###########################################################################
# IP Routing Tests
# Note: Configure 'clients' and 'ip_routing' in config.yml before running
###########################################################################

### 20. IP Routing - Chat with X-Forwarded-For header
POST http://127.0.0.1:11345/api/chat
Accept: application/json
Content-Type: application/json
X-Forwarded-For: 192.168.1.100

{
    "model": "Smart Assistant",
    "messages": [
        {
            "role": "user",
            "content": "What model are you? Reply in one sentence."
        }
    ],
    "stream": false
}

### 21. IP Routing - Same model, non-matching IP (uses default model)
POST http://127.0.0.1:11345/api/chat
Accept: application/json
Content-Type: application/json
X-Forwarded-For: 10.0.0.99

{
    "model": "Smart Assistant",
    "messages": [
        {
            "role": "user",
            "content": "What model are you? Reply in one sentence."
        }
    ],
    "stream": false
}

### 22. IP Routing - With X-Real-IP header
POST http://127.0.0.1:11345/api/chat
Accept: application/json
Content-Type: application/json
X-Real-IP: 10.0.0.5

{
    "model": "Smart Assistant",
    "messages": [
        {
            "role": "user",
            "content": "What model are you? Reply in one sentence."
        }
    ],
    "stream": false
}

### 23. IP Routing - X-Forwarded-For with multiple IPs (uses first)
POST http://127.0.0.1:11345/api/chat
Accept: application/json
Content-Type: application/json
X-Forwarded-For: 192.168.1.100, 10.0.0.1, 172.16.0.1

{
    "model": "Smart Assistant",
    "messages": [
        {
            "role": "user",
            "content": "What model are you? Reply in one sentence."
        }
    ],
    "stream": false
}

### 24. IP Routing - Streaming with X-Forwarded-For
POST http://127.0.0.1:11345/api/chat
Accept: application/x-ndjson
Content-Type: application/json
X-Forwarded-For: 192.168.1.100

{
    "model": "Smart Assistant",
    "messages": [
        {
            "role": "user",
            "content": "Say hello"
        }
    ],
    "stream": true
}

###########################################################################
# Tracing Tests
# Note: Enable 'tracing' section in config.yml before running
###########################################################################

### 25. Tracing - Chat with custom trace-id (passthrough to LiteLLM)
POST http://127.0.0.1:11345/api/chat
Accept: application/json
Content-Type: application/json
x-litellm-trace-id: my-custom-trace-123

{
    "model": "openai/gpt-4o-mini",
    "messages": [
        {
            "role": "user",
            "content": "Ping?"
        }
    ],
    "stream": false
}

### 26. Tracing - Streaming chat (auto-generated trace-id in logs)
POST http://127.0.0.1:11345/api/chat
Accept: application/x-ndjson
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "messages": [
        {
            "role": "user",
            "content": "Say hello"
        }
    ],
    "stream": true
}

### 27. Tracing - Generate with custom trace-id
POST http://127.0.0.1:11345/api/generate
Accept: application/json
Content-Type: application/json
x-litellm-trace-id: generate-trace-456

{
    "model": "openai/gpt-4o-mini",
    "prompt": "Hello",
    "stream": false
}

###########################################################################
# OpenAI-compatible API (/v1)
# If openai_api.api_keys is set, replace the key below; otherwise any key works.
###########################################################################

### 28. /v1 - List models
GET http://127.0.0.1:11434/v1/models
Authorization: Bearer sk-local-change-me

### 29. /v1 - Retrieve a model (id may contain "/")
GET http://127.0.0.1:11434/v1/models/openai/gpt-4o-mini
Authorization: Bearer sk-local-change-me

### 30. /v1 - Chat completion (non-streaming)
POST http://127.0.0.1:11434/v1/chat/completions
Authorization: Bearer sk-local-change-me
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "messages": [{"role": "user", "content": "Ping?"}]
}

### 31. /v1 - Chat completion (streaming with usage chunk)
POST http://127.0.0.1:11434/v1/chat/completions
Authorization: Bearer sk-local-change-me
Accept: text/event-stream
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "messages": [{"role": "user", "content": "Write a haiku about proxies."}],
    "stream": true,
    "stream_options": {"include_usage": true}
}

### 32. /v1 - Tool calling (expect tool_calls + finish_reason "tool_calls")
POST http://127.0.0.1:11434/v1/chat/completions
Authorization: Bearer sk-local-change-me
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "messages": [{"role": "user", "content": "What is the weather in Paris?"}],
    "tools": [
        {
            "type": "function",
            "function": {
                "name": "get_weather",
                "description": "Get current weather for a city",
                "parameters": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}
            }
        }
    ]
}

### 33. /v1 - Image content part
POST http://127.0.0.1:11434/v1/chat/completions
Authorization: Bearer sk-local-change-me
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "messages": [
        {
            "role": "user",
            "content": [
                {"type": "text", "text": "What color is this pixel?"},
                {"type": "image_url", "image_url": {"url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFBQIAX8jx0gAAAABJRU5ErkJggg=="}}
            ]
        }
    ]
}

### 34. /v1 - Developer role + system_prompt_mode (send "debug" to inspect the merge)
POST http://127.0.0.1:11434/v1/chat/completions
Authorization: Bearer sk-local-change-me
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "messages": [
        {"role": "developer", "content": "You are a coding agent with tools."},
        {"role": "user", "content": "debug"}
    ]
}

### 35. /v1 - Legacy completion (non-streaming)
POST http://127.0.0.1:11434/v1/completions
Authorization: Bearer sk-local-change-me
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "prompt": "Say hello in French:",
    "max_tokens": 20
}

### 36. /v1 - Legacy completion (streaming)
POST http://127.0.0.1:11434/v1/completions
Authorization: Bearer sk-local-change-me
Accept: text/event-stream
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "prompt": "Count to five:",
    "stream": true
}

### 37. /v1 - Error: missing/invalid API key (expect 401 when api_keys is set)
GET http://127.0.0.1:11434/v1/models
Authorization: Bearer wrong-key

### 38. /v1 - Error: unsupported suffix (expect 400 unsupported_parameter)
POST http://127.0.0.1:11434/v1/completions
Authorization: Bearer sk-local-change-me
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "prompt": "def add(a, b):",
    "suffix": "return result"
}

### 39. /v1 - Error: unknown endpoint (expect 404 unknown_url)
POST http://127.0.0.1:11434/v1/responses
Authorization: Bearer sk-local-change-me
Content-Type: application/json

{}

### 40. Client label prefix - "Text:\ndebug" must still hit the debug output
POST http://127.0.0.1:11434/api/chat
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "messages": [
        {"role": "user", "content": "Text:\ndebug"}
    ]
}

### 41. Client label prefix - stripped before the model sees it (check message[N] in the debug dump)
POST http://127.0.0.1:11434/api/generate
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "prompt": "Текст:\ndebug"
}

### 42. /v1 - Client label prefix on a content-part message
POST http://127.0.0.1:11434/v1/chat/completions
Authorization: Bearer sk-local-change-me
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "messages": [
        {"role": "user", "content": [{"type": "text", "text": "Text:\ndebug"}]}
    ]
}

### 43. Client label prefix - NOT stripped on one line (expect a normal model answer)
POST http://127.0.0.1:11434/api/chat
Content-Type: application/json

{
    "model": "openai/gpt-4o-mini",
    "messages": [
        {"role": "user", "content": "Text: say hi"}
    ]
}
